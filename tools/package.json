{
  "name": "etg-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Build and integrity tooling for Everything That Glows (EPUB export + HTML checks). Not part of the published site.",
  "scripts": {
    "check": "node check-html.mjs",
    "build:epub": "node build-epub.mjs",
    "prepare:cover": "node prepare-cover.mjs",
    "all": "node check-html.mjs && node build-epub.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jpeg-js": "^0.4.4",
    "jsdom": "^24.1.0",
    "mathjax-full": "^3.2.2"
  }
}
